# Database connection (PostgreSQL on Neon)
# Replace with your actual connection string — never commit the real .env file.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require"

# Optional: license signing secret (defaults to a built-in key if not set)
# LICENSE_SECRET="your-license-signing-secret"

# Optional: SMTP settings for shift reports and notifications
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="587"
# SMTP_SECURE="false"
# SMTP_USER="your-smtp-user"
# SMTP_PASS="your-smtp-password"
# SMTP_FROM="noreply@example.com"
# SHIFT_REPORT_EMAIL="shift-reports@example.com"

# Optional: public app URL (for receipts, links, etc.)
# NEXT_PUBLIC_APP_URL="https://your-app.example.com"
