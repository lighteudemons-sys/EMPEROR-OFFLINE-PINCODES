download/
scripts/*.bak
*.old.bak

# OS / IDE
.DS_Store
.vscode/
.idea/
*.swp
*.swo

# Z.ai sandbox infrastructure (not part of the application)
.zscripts/
upload/
mini-services/.gitkeep
tests/
examples/

# Local PostgreSQL data (for restore testing)
/tmp/pg-restore-test-data/
